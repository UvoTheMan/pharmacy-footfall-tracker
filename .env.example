# Copy to .env.local and fill in values from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Interface-level admin token required by the Change Password dialog.
# IMPORTANT: Vite exposes VITE_* values in browser code; this is only a deterrent, not a secure secret.
VITE_PASSWORD_CHANGE_TOKEN=SET_A_TOKEN_FOR_THE_CHANGE_PASSWORD_DIALOG
